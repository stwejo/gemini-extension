          "id": "s1",
          "type": "listen",
          "situation_fr": "Premier jour de stage. La responsable explique les horaires à Karim.",
          "lines": [
            {
              "speaker": "De chef",
              "nl": "Je moet om negen uur beginnen.",
              "fr": "Tu dois commencer à neuf heures."
            },
            {
              "speaker": "Karim",
              "nl": "En hoe laat mag ik pauze nemen?",
              "fr": "Et à quelle heure puis-je prendre une pause ?"
            },
            {
              "speaker": "De chef",
              "nl": "Je mag om twaalf uur eten. Je moet wel op tijd terug zijn.",
              "fr": "Tu peux manger à midi. Mais tu dois être de retour à l'heure.",
              "note_fr": "wel insiste : « par contre », « quand même »."
            },
            {
              "speaker": "Karim",
              "nl": "Natuurlijk. Moet ik hier ook schoenen uitdoen?",
              "fr": "Bien sûr. Dois-je aussi enlever mes chaussures ici ?"
            },
            {
              "speaker": "De chef",
              "nl": "Nee, dat hoeft niet.",
              "fr": "Non, ce n'est pas nécessaire."
            },
            {
              "speaker": "Karim",
              "nl": "Oké, dank u!",
              "fr": "D'accord, merci !"
            }
          ]
        },
        {
          "id": "s2",
