          "id": "s5",
          "type": "discover",
          "intro_fr": "Compare obligation, permission et absence d'obligation.",
          "examples": [
            {
              "nl": "Je moet om negen uur beginnen.",
              "fr": "Tu dois commencer à neuf heures.",
              "highlight": [
                "moet"
