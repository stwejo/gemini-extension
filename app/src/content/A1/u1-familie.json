              "nl": "de man → de mannen",
              "fr": "l'homme → les hommes"
            },
            {
              "nl": "het raam → de ramen",
              "fr": "la fenêtre → les fenêtres"
            },
            {
              "nl": "de foto → de foto's",
              "fr": "la photo → les photos"
            }
          ],
          "exceptions_fr": [
            "Pluriels irréguliers courants : het kind → de kinderen, het ei → de eieren, de stad → de steden, het schip → de schepen.",
