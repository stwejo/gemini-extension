            {
              "speaker": "Karim",
              "nl": "Heb je broers of zussen?",
              "fr": "Tu as des frères ou des sœurs ?"
            },
            {
              "speaker": "Anna",
              "nl": "Ja, ik heb een broer en twee zussen.",
              "fr": "Oui, j'ai un frère et deux sœurs."
            },
            {
              "speaker": "Karim",
              "nl": "En hoe heet je broer?",
              "fr": "Et comment s'appelle ton frère ?"
            },
            {
              "speaker": "Anna",
              "nl": "Hij heet Thomas. Hij is achttien.",
              "fr": "Il s'appelle Thomas. Il a dix-huit ans."
            },
            {
              "speaker": "Karim",
              "nl": "Woont hij nog thuis?",
              "fr": "Il habite encore chez vos parents ?"
            },
            {
              "speaker": "Anna",
              "nl": "Ja, hij woont nog bij mijn ouders. En jij?",
              "fr": "Oui, il habite encore chez mes parents. Et toi ?"
            },
            {
              "speaker": "Karim",
              "nl": "Ik heb geen broers of zussen. Ik ben enig kind.",
              "fr": "Je n'ai ni frère ni sœur. Je suis fils unique.",
              "note_fr": "geen = pas de : la négation devant un nom. Elle est travaillée dans l'unité 2."
