        {
          "id": "s6",
          "type": "rule",
          "ruleId": "er-is-er-zijn",
          "title_fr": "er is / er zijn (il y a)",
          "body_fr": "Pour signaler l'existence de quelque chose : er is + singulier, er zijn + pluriel. Question : Is er …? / Zijn er …? Négation : er is geen … / er zijn geen … Si la phrase commence par un complément, er vient après le verbe : In de buurt is er een supermarkt, ou plus simplement In de buurt is een supermarkt.",
          "examples": [
            {
              "nl": "Er is een probleem.",
              "fr": "Il y a un problème."
            },
            {
              "nl": "Er zijn veel mensen.",
              "fr": "Il y a beaucoup de gens."
            },
            {
              "nl": "Is er een toilet?",
              "fr": "Y a-t-il des toilettes ?"
            },
            {
              "nl": "Er is geen plaats meer.",
              "fr": "Il n'y a plus de place."
