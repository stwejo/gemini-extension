          "question": {
            "id": "d1",
            "question_fr": "Comment le néerlandais écrit-il une voyelle longue dans ces mots ?",
            "choices": [
              "Il double la lettre : aa, oo",
              "Il ajoute un accent : à, ò",
              "Il ajoute un h : ah, oh"
            ],
            "answerIndex": 0,
            "explain_fr": "man → maan, zon → zoon : la voyelle doublée se tient plus longtemps."
          },
          "reveal_fr": "Dans une syllabe fermée (qui finit par une consonne), la voyelle longue s'écrit avec deux lettres. La longueur de la voyelle change le sens du mot : ce n'est pas un détail."
        },
        {
          "id": "s6",
          "type": "rule",
          "ruleId": "spelling-klinkers",
          "title_fr": "Voyelle courte ou longue : comment ça s'écrit",
          "body_fr": "Syllabe fermée (elle finit par une consonne) : une seule lettre = voyelle courte (man, zon). Deux lettres = voyelle longue (maan, zoon). Syllabe ouverte (elle finit par la voyelle) : une seule lettre suffit pour une voyelle longue (ma-nen, zo-nen = les lunes). C'est pour cela que le pluriel de man est mannen : on double la consonne pour garder la syllabe fermée et donc la voyelle courte.",
          "examples": [
            {
              "nl": "man → mannen",
              "fr": "l'homme → les hommes (voyelle courte conservée)"
            },
            {
              "nl": "maan → manen",
              "fr": "la lune → les lunes (voyelle longue en syllabe ouverte)"
            },
            {
              "nl": "zon → zonnen",
              "fr": "le soleil → les soleils"
            },
            {
              "nl": "zoon → zonen",
              "fr": "le fils → les fils"
            }
          ],
          "exceptions_fr": [
            "Les groupes ie, oe, eu, ui, ij, ei, ou, au ne se doublent jamais.",
            "Le e final d'un mot court se prononce « e muet » : de, ze, je."
          ]
        },
