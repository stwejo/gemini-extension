          "question": {
            "id": "d1",
            "question_fr": "Pourquoi « jij woont » devient-il « woon je » dans la question ?",
            "choices": [
              "Parce que le -t disparaît quand je / jij suit le verbe",
              "Parce que la question est au passé",
