        {
          "id": "s1",
          "type": "listen",
          "situation_fr": "Premier jour d'un cours du soir. Deux participants se parlent avant le début.",
          "lines": [
            {
              "speaker": "Youssef",
              "nl": "Hoi! Ik ben Youssef. En jij, hoe heet je?",
              "fr": "Salut ! Je suis Youssef. Et toi, comment t'appelles-tu ?"
            },
            {
              "speaker": "Lotte",
              "nl": "Ik heet Lotte. Aangenaam!",
              "fr": "Je m'appelle Lotte. Enchantée !"
            },
            {
              "speaker": "Youssef",
              "nl": "Aangenaam. Ben jij ook nieuw hier?",
              "fr": "Enchanté. Tu es nouvelle ici aussi ?",
              "note_fr": "« jij bent » devient « ben jij » dans la question : le -t disparaît."
            },
            {
              "speaker": "Lotte",
              "nl": "Ja, ik ben nieuw. En jij?",
              "fr": "Oui, je suis nouvelle. Et toi ?"
            },
            {
              "speaker": "Youssef",
              "nl": "Ik ook. De cursus is leuk, hè?",
              "fr": "Moi aussi. Le cours est sympa, hein ?"
            },
            {
              "speaker": "Lotte",
              "nl": "Ja, heel leuk!",
              "fr": "Oui, très sympa !"
            }
          ]
        },
