      "minutes": 13,
      "steps": [
        {
          "id": "s1",
          "type": "listen",
          "situation_fr": "Deux collègues se croisent dans le couloir du bureau.",
          "lines": [
            {
              "speaker": "Anna",
              "nl": "Hoi Bram! Hoe gaat het?",
              "fr": "Salut Bram ! Comment ça va ?"
            },
            {
              "speaker": "Bram",
              "nl": "Het gaat wel. Ik ben een beetje moe. En met jou?",
              "fr": "Ça va à peu près. Je suis un peu fatigué. Et toi ?",
              "note_fr": "« Het gaat wel » = ça va, sans plus."
            },
            {
              "speaker": "Anna",
              "nl": "Met mij gaat het prima!",
              "fr": "Moi, ça va très bien !"
            },
            {
              "speaker": "Bram",
              "nl": "Mooi. Vandaag is het rustig.",
              "fr": "Bien. Aujourd'hui, c'est calme."
            },
            {
              "speaker": "Anna",
              "nl": "Ja, gelukkig! Tot later!",
              "fr": "Oui, heureusement ! À plus tard !"
            },
            {
              "speaker": "Bram",
              "nl": "Tot later!",
              "fr": "À plus tard !"
            }
          ]
